# Copy to .env.production and set through a secret manager.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
NODE_ENV=production
LEADERSHIP_PERSISTENCE=postgres
LEADERSHIP_TENANT_ID=00000000-0000-0000-0000-000000000001
LEADERSHIP_API_TOKENS={"replace-admin-token":"admin","replace-editor-token":"editor","replace-auditor-token":"auditor","replace-viewer-token":"viewer"}
APP_PORT=8001
LEADERSHIP_AUTOMATION_PAUSED=false
LEADERSHIP_AUTOMATION_INTERVAL_MS=300000
# HMAC secret used to authenticate the AI governance manifest.
LEADERSHIP_AI_GOVERNANCE_SECRET=replace-with-a-secret-manager-value
LEADERSHIP_BACKUP_SIGNING_SECRET=replace-with-a-secret-manager-value
# Optional signed webhook configuration.
# LEADERSHIP_WEBHOOKS=[{"url":"https://example.invalid/hook","events":["automation.*"],"secret":"replace-webhook-secret"}]

# Outbound webhook subscriptions (Slack/Teams/generic) with HMAC signing.
# LEADERSHIP_OUTBOUND_WEBHOOKS=[{"url":"https://hooks.slack.com/services/xxx","events":["*"],"channel":"slack","secret":"replace-hmac-secret"}]

# Policy engine kill-switch: when true, all policy decisions force BLOCK.
# LEADERSHIP_TRADING_KILL_SWITCH=false

# OIDC SSO (optional). Points the /api/oidc/* endpoints at a real provider
# (Azure AD / Entra, Google, Keycloak, Auth0). Roles derive from group claims.
# LEADERSHIP_OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# LEADERSHIP_OIDC_CLIENT_ID=replace-with-your-client-id
# LEADERSHIP_OIDC_CLIENT_SECRET=replace-with-your-client-secret
# LEADERSHIP_OIDC_REDIRECT_URI=https://your-domain/v1/oidc/callback

# External notarization (round-19): publish the daily attestation to an
# append-only notary (or any HTTPS endpoint that echoes the root back).
# Leave unset to keep attestation local (publish returns an honest 502).
# LEADERSHIP_NOTARY_URL=https://notary.example.com/attestations
# LEADERSHIP_NOTARY_SECRET=replace-with-hmac-secret

# ── AI Leadership Modules ───────────────────────────────────────────────────
# Enable the AI-powered leadership mentor, navigator, predictive intelligence,
# cultural intelligence, and seamless UX features. Requires LEADERSHIP_LLM_PROVIDER
# or LEADERSHIP_OLLAMA_ENABLED for full LLM-powered features; deterministic
# fallbacks work without LLM.
# LEADERSHIP_AI_ENABLED=true

# ── LLM / AI providers ───────────────────────────────────────────────────────
# The AI routes (chief-of-staff briefing, narratives, decision analysis) use
# whichever provider is configured. LEADERSHIP_LLM_PROVIDER forces one;
# otherwise the first configured wins (ollama if enabled, else openrouter,
# groq, cerebras, openai, mistral in that order). Env keys win over admin-registered
# credentials stored via the /api/llm/credentials API (which requires
# LEADERSHIP_DATA_ENCRYPTION_KEY so keys are never stored in plaintext).
# LEADERSHIP_LLM_PROVIDER=openrouter
# OPENCODE_API_KEY=replace-with-opencode-zen-key
# OPENROUTER_API_KEY=replace-with-openrouter-key
# OPENAI_API_KEY=replace-with-openai-key
# GROQ_API_KEY=replace-with-groq-key
# MISTRAL_API_KEY=replace-with-mistral-key
# LLM_MODEL=replace-with-model-id  (optional override, e.g. openrouter/auto)
# Local option: LEADERSHIP_OLLAMA_ENABLED=true with LEADERSHIP_OLLAMA_URL and
# LEADERSHIP_OLLAMA_MODEL (defaults http://127.0.0.1:11434 and llama3.2).

# ─── Sessions ─────────────────────────────────────────────────────────────
# LEADERSHIP_SESSION_TTL_MS=43200000        # Session lifetime (default 12h)
# LEADERSHIP_MAX_ACTIVE_SESSIONS=10         # Per-user concurrent-session cap
#                                           # (0 = unlimited; oldest sessions
#                                           # beyond the cap are revoked)

# ─── Local-dev access (NODE_ENV != production) ────────────────────────────
# Unset = loopback-only anonymous admin (safe default for `node server.js`).
# LEADERSHIP_ALLOW_UNAUTHENTICATED_LOCAL=true   # LAN/dev machines (explicit)
# LEADERSHIP_ALLOW_UNAUTHENTICATED_LOCAL=false  # closed everywhere
# Production always denies unauthenticated access regardless of this flag.

# ─── Backups ──────────────────────────────────────────────────────────────
# LEADERSHIP_BACKUP_DIR=/absolute/path/to/backups   # automatic scheduler target
# LEADERSHIP_BACKUP_ENABLED=true                    # set false to disable
# LEADERSHIP_BACKUP_INTERVAL_MS=3600000             # cron-window check cadence
