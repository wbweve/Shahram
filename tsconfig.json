{
  "compilerOptions": {
    "strict": true,
    "target": "ES2019",
    "module": "CommonJS",
    "esModuleInterop": true,
    "lib": ["ES2019", "DOM"],
    "rootDir": "src",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
