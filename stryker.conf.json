{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Run: npx stryker run. Gap #14: mutation testing CI gate — expanded to cover all new modules.",
  "mutate": ["js/calc.js", "js/chain-anchor.js", "js/consistency-verifier.js", "js/retention.js", "js/incident-management.js", "js/person-index.js", "js/mentorship.js", "js/experiments.js", "js/automation-evidence.js", "js/cross-domain-journeys.js", "js/close-to-report-pipeline.js", "js/causal-integration-runtime.js", "js/ai-governance-enforcer.js", "js/restore-drill-automation.js", "js/tenant-data-export.js", "js/decision-simulation.js", "js/model-training-pipeline.js", "js/offline-conflict-resolver.js", "js/crdt-collaboration.js", "js/connector-hardening.js", "js/learning-org-score.js", "js/plugin-marketplace.js", "js/live-benchmarks.js", "lib/webauthn.js", "lib/kms.js"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node test.js && node test/fuzz.test.js && node test/calc-supplemental.test.js && node test/mutation-target.test.js && node test/mutation-kill.test.js && node test/trust-layer.test.js && node test/people-layer.test.js && node test/incident-experiments.test.js && node test/llm-narrative.test.js"
  },
  "reporters": ["progress", "html", "clear-text", "json"],
  "jsonReporter": {
    "fileName": "eval-reports/mutation-report.json"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 60000,
  "mutator": "javascript",
  "packageManager": "npm"
}