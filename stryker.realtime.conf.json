{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["js/realtime-collaboration.js"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node test/realtime-collab.test.js && node test/mutation-target.test.js"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "eval-reports/mutation-realtime.json"
  },
  "thresholds": { "high": 80, "low": 60, "break": 0 }
}